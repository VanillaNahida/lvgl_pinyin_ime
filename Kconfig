menu "LVGL Pinyin IME"

    choice LV_PINYIN_IME_DEFAULT_MODE
        prompt "Default keyboard mode"
        default LV_PINYIN_IME_MODE_K26

        config LV_PINYIN_IME_MODE_K26
            bool "26-key (K26)"

        config LV_PINYIN_IME_MODE_K9
            bool "9-key (T9)"
    endchoice

    choice LV_PINYIN_IME_DOUBLE_SCHEME
        prompt "Double pinyin scheme"
        default LV_PINYIN_IME_SCHEME_XIAOHE

        config LV_PINYIN_IME_SCHEME_NONE
            bool "Not used (full pinyin only)"

        config LV_PINYIN_IME_SCHEME_XIAOHE
            bool "Xiaohe"

        config LV_PINYIN_IME_SCHEME_ZIRANMA
            bool "Ziranma"

        config LV_PINYIN_IME_SCHEME_MS
            bool "Microsoft"

        config LV_PINYIN_IME_SCHEME_ABC
            bool "Smart ABC"

        config LV_PINYIN_IME_SCHEME_ZIGUANG
            bool "Ziguang"

        config LV_PINYIN_IME_SCHEME_PYJJ
            bool "Pinyin Jiajia"
    endchoice

    config LV_PINYIN_IME_FUZZY_DEFAULT
        bool "Enable fuzzy pinyin by default"
        default n

    config LV_PINYIN_IME_ASSOC_DEFAULT
        bool "Enable association by default"
        default y

    config LV_PINYIN_IME_MAX_CANDIDATES
        int "Maximum candidates per search"
        range 1 512
        default 60

    config LV_PINYIN_IME_CAND_PAGE_SIZE
        int "Candidates per page"
        range 1 32
        default 8

    config LV_PINYIN_IME_K9_MAX_PY_CAND
        int "Maximum pinyin candidates in the 9-key row"
        range 1 64
        default 20

    config LV_PINYIN_IME_MAX_PINYIN_LEN
        int "Maximum pinyin buffer length"
        range 8 128
        default 32

    choice LV_PINYIN_IME_DICT_SRC
        prompt "System dictionary source"
        default LV_PINYIN_IME_DICT_SRC_PARTITION

        config LV_PINYIN_IME_DICT_SRC_PARTITION
            bool "Flash partition"

        config LV_PINYIN_IME_DICT_SRC_SDCARD
            bool "SD card"

        config LV_PINYIN_IME_DICT_SRC_EMBEDDED
            bool "Embedded in application"
    endchoice

    config LV_PINYIN_IME_DICT_PARTITION
        string "System dictionary partition name"
        depends on LV_PINYIN_IME_DICT_SRC_PARTITION
        default "dict"

    config LV_PINYIN_IME_DICT_SD_PATH
        string "System dictionary path on SD card"
        depends on LV_PINYIN_IME_DICT_SRC_SDCARD
        default "/sdcard/dict_pinyin.dat"

    config LV_PINYIN_IME_USER_PARTITION
        string "User dictionary partition name"
        default "usr"

    config LV_PINYIN_IME_USER_AUTOSAVE_EVERY
        int "Auto save user dictionary every N commits"
        range 1 1000
        default 10

    choice LV_PINYIN_IME_FONT_SRC
        prompt "Font source"
        default LV_PINYIN_IME_FONT_SRC_EMBEDDED

        config LV_PINYIN_IME_FONT_SRC_EMBEDDED
            bool "Embedded in application"
            help
                The fonts generated by tools/gen_font.py as C arrays are compiled
                into the application: nothing to flash, no file system involved.
                This is the default because it works on a fresh board.

        config LV_PINYIN_IME_FONT_SRC_PARTITION
            bool "Flash partition"
            help
                The fonts are generated as LVGL binary fonts, concatenated into
                generated/font_partition.bin and flashed to the "font" partition.
                Needs CONFIG_LV_USE_FS_MEMFS.
    endchoice

    config LV_PINYIN_IME_FONT_PARTITION
        string "Font partition name"
        depends on LV_PINYIN_IME_FONT_SRC_PARTITION
        default "font"

    config LV_PINYIN_IME_FONT_SIZE_BIG
        int "Big font size (px)"
        range 8 64
        default 20

    config LV_PINYIN_IME_FONT_SIZE_SMALL
        int "Small font size (px)"
        range 8 64
        default 16

    config LV_PINYIN_IME_EXT_DICT_ENABLE
        bool "Enable external dictionary on SD card"
        default n

    config LV_PINYIN_IME_EXT_DICT_PATH
        string "External dictionary path"
        depends on LV_PINYIN_IME_EXT_DICT_ENABLE
        default "/sdcard/ime_ext.bin"

endmenu